# EVREN LLM API anahtarı — yalnızca backend tarafında kullanılır.
# Bu dosyayı .env olarak kopyalayıp aşağıdaki değeri kendi anahtarınızla değiştirin.
# .env dosyası .gitignore tarafından hariç tutulur.
EVREN_LLM_API_KEY=evren_llm_buraya_anahtarinizi_yazin

# İsteğe bağlı ayarlar
# EVREN_LLM_MODEL=auto
# EVREN_LLM_MAX_TOKENS=700
# EVREN_LLM_BASE_URL=https://evren-llmapi.ssyz.org.tr
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
